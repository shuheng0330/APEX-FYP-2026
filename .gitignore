# 🌐 Global ignores
.DS_Store
Thumbs.db

# 🧠 IntelliJ IDEA
.idea/
*.iml

# 🚀 Spring Boot (backend)
backend/src/main/resources/static
backend/target/
backend/source/
backend/.env
backend/.env.*
backend/src/test/resources/*
# The shared H2 test settings are tracked; generated files (e.g. temp-uploads) stay ignored.
!backend/src/test/resources/application-test.yml
backend/docs
backend/uploads/

# Local working documents (requirements drafts, audits): not pushed
/docs/

*.log

# 🌐 Angular (frontend)
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/src/environments/
frontend/.vscode
frontend/CLAUDE.md
frontend/docs/

# 🧪 Test/coverage output
**/coverage/
**/.nyc_output/

# 🧾 Logs
*.log

# 💾 OS generated files
*.swp
*.swo
*.tmp
